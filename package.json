{
  "name": "@structured-world/vue-privacy",
  "version": "2.0.0",
  "description": "GDPR cookie consent banner and Google Analytics (GA4) for Vue 3, Nuxt, VitePress and Quasar: Google Consent Mode v2, 31 languages, region detection, CCPA, script blocking and SPA page tracking.",
  "license": "Apache-2.0",
  "author": "Dmitry Prudnikov <mail@polaz.com>",
  "packageManager": "yarn@4.12.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/vue-privacy.umd.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./vitepress": {
      "types": "./dist/vitepress/index.d.ts",
      "import": "./dist/vitepress/index.js"
    },
    "./quasar": {
      "types": "./dist/quasar/index.d.ts",
      "import": "./dist/quasar/index.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js"
    },
    "./banner.css": "./dist/vue-privacy-banner.css",
    "./modal.css": "./dist/vue-privacy-modal.css"
  },
  "main": "./dist/vue-privacy.umd.cjs",
  "module": "./dist/index.js",
  "unpkg": "./dist/vue-privacy.umd.cjs",
  "jsdelivr": "./dist/vue-privacy.umd.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/structured-world/vue-privacy"
  },
  "homepage": "https://privacy.sw.foundation",
  "bugs": {
    "url": "https://github.com/structured-world/vue-privacy/issues"
  },
  "keywords": [
    "cookie-consent",
    "cookie-banner",
    "consent-management",
    "gdpr",
    "ccpa",
    "google-consent-mode",
    "consent-mode-v2",
    "google-analytics",
    "ga4",
    "gtag",
    "vue",
    "vue3",
    "nuxt",
    "vitepress",
    "quasar",
    "i18n",
    "privacy",
    "spa-tracking",
    "analytics",
    "page-view",
    "cdn",
    "umd"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.config.umd.ts && vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12"
  },
  "resolutions": {
    "esbuild": "0.27.2",
    "npm": ">=11.9.0"
  }
}
